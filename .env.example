# API Keys for LLM Providers (Google Gemini or OpenAI)
# If no key is set, the system seamlessly uses the local Angolan Agronomist Synthesizer
GEMINI_API_KEY=
OPENAI_API_KEY=

# LLM Model Configuration
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
HOST=0.0.0.0
PORT=8000
